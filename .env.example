# Frontend build environment (local shell or static-site build settings)
VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id
VITE_CLOUDBASE_PUBLISHABLE_KEY=your-cloudbase-publishable-key
# Use cloudbase for the real online runtime. mock is only for local acceptance testing.
VITE_API_MODE=cloudbase

# CloudBase agent-api function environment (server side only; never prefix with VITE_)
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-in-cloudbase-console
LLM_MODEL=your-structured-output-model
# Comma-separated CloudBase user IDs that may publish reviewed knowledge items.
KNOWLEDGE_OWNER_USER_IDS=replace-with-trusted-cloudbase-user-id
